# Для запуска из IDE скопируйте файл в src/main/resources/users.env.
# В Docker Compose используется runtime/users.env, смонтированный как /config/users.env.
# Изменения применяются без перезапуска максимум через 5 секунд.

USERS_0_EMAIL='admin@example.com'
USERS_0_PASSWORD='replace-with-a-strong-admin-password'
USERS_0_ROLE='ADMIN'
USERS_0_STATUS='ACTIVE'

USERS_1_EMAIL='employee@example.com'
USERS_1_PASSWORD='replace-with-a-strong-employee-password'
USERS_1_ROLE='EMPLOYEE'
USERS_1_STATUS='ACTIVE'

USERS_2_EMAIL='disabled.employee@example.com'
USERS_2_PASSWORD='replace-with-a-strong-password'
USERS_2_ROLE='EMPLOYEE'
USERS_2_STATUS='DISABLED'
