# Для запуска из IDE скопируйте файл в src/main/resources/users.env.
# Для локального Docker Compose создайте runtime/users.env до запуска.
# На сервере создайте /home/kinoko/hack-autumn-2026/runtime/users.env.
# Эта папка находится вне api, который пайплайн удаляет при каждом деплое.
# Пайплайн проверит файл до остановки приложения и смонтирует папку как /config:ro.
# Для файла под root: root:root, каталог 750, файл 640; контейнеру добавлена группа 0.
# Изменения применяются без перезапуска максимум через 5 секунд.

USERS_0_LOGIN='admin'
USERS_0_PASSWORD='replace-with-a-strong-admin-password'
USERS_0_ROLE='ADMIN'
USERS_0_STATUS='ACTIVE'
