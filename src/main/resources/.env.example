# Скрипт деплоя принудительно устанавливает этот профиль в prod.
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL
# Одинарные кавычки сохраняют $, # и другие специальные символы в Docker Compose.
SPRING_DATASOURCE_URL='jdbc:postgresql://postgres:5432/hack-autumn-2026'
SPRING_DATASOURCE_USERNAME='change_me'
SPRING_DATASOURCE_PASSWORD='change_me'

# Ключ подписи JWT в Base64 (после декодирования — не менее 32 байт).
APP_AUTH_JWT_SECRET='replace_with_a_random_base64_secret'
APP_AUTH_SECURE_COOKIE='true'

# Keycloak OIDC. Создайте realm и confidential client в Keycloak перед включением.
APP_AUTH_OIDC_ENABLED='false'
# Рекомендуется явная привязка issuer + sub в users.env.
APP_AUTH_OIDC_AUTO_LINK_BY_EMAIL='false'
APP_AUTH_OIDC_ISSUER_URI='https://task.kinoko.su/realms/your-realm'
APP_AUTH_OIDC_CLIENT_ID='hack-autumn-2026-api'
APP_AUTH_OIDC_CLIENT_SECRET='replace_with_oidc_client_secret'
# Путь фронтенда на том же origin, что и API.
APP_AUTH_OIDC_SUCCESS_REDIRECT_URI='/'

# Live generator and ML (disabled until their private services are configured).
APP_GENERATOR_ENABLED=false
APP_GENERATOR_USE_FOR_DASHBOARD=false
APP_GENERATOR_SOURCE_ID=aeza-live
APP_GENERATOR_BASE_URL=http://generator-api:8000
APP_GENERATOR_SERVICE_TOKEN=
APP_GENERATOR_POLL_DELAY_MS=1000
APP_GENERATOR_PAGE_SIZE=100
APP_GENERATOR_APPLY_BATCH_SIZE=1000
APP_GENERATOR_REQUEST_TIMEOUT=10s
APP_ML_ENABLED=false
APP_ML_BASE_URL=http://ml-service:8000
APP_ML_SERVICE_TOKEN=
APP_ML_MODEL_VERSION=event-driven-all-terms-v1-234422ba1357
APP_ML_REQUEST_TIMEOUT=2s
APP_ML_CACHE_TTL=30s
APP_ML_MAX_HISTORY_EVENTS=100000
